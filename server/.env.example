# OpenCode Zen API key (https://opencode.ai/auth)
OPENCODE_ZEN_API=

# Model to use for AI explanations (free options: deepseek-v4-flash-free, big-pickle)
ZEN_MODEL=deepseek-v4-flash-free

# Server
PORT=3001
HOST=localhost

# Playwright scan
SCAN_TIMEOUT_MS=30000

# Logging
LOG_DIR=
LOG_FILE=equicheck.log
LOG_LEVEL=info